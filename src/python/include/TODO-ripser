// englober CNS et bitfield, mais probablement pas plus
// suppose que le codage d'un simplexe est la somme des codages de (vert,pos)
concept SimplexEncoding {
  using vertex_t=
  using simplex_t=
  ? using dimension_t= (for position)
  ? using coefficient_t= (handled as data)
  const int num_coef_bits
  constructor(n_vertices, max_dim)
  encode(vertex, position) -> simplex
  get_max_vertex(simplex, position) -> vertex (forme faible de decode() qui ne marche que sur le dernier)
}

